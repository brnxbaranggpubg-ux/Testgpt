+    /** Decorative Hanfu-inspired hair pieces; purely visual and independent of the kasa toggle. */
+    private void renderHanfuOrnament(VertexConsumer out, Vec3d camera, PlayerEntity player, float partial) {
+        Vec3d pos = player.getLerpedPos(partial);
+        float yaw = MathHelper.lerpAngleDegrees(partial, player.prevYaw, player.getYaw());
+        double angle = Math.toRadians(yaw);
+        Vec3d right = new Vec3d(Math.cos(angle), 0, Math.sin(angle));
+        Vec3d forward = new Vec3d(-Math.sin(angle), 0, Math.cos(angle));
+        Vec3d head = pos.add(0, player.isInSneakingPose() ? 1.49 : 1.68, 0);
+        double scale = config.moduleValue("hanfu_ornament", "scale", 1f, 0.25f, 3f);
+        float previousAlpha = GEOMETRY_ALPHA.get();
+        GEOMETRY_ALPHA.set(previousAlpha * config.moduleValue("hanfu_ornament", "opacity", 1f, 0.10f, 1f));
+        Theme theme = Themes.current(config);
+        int gold = withAlpha(0xFFFFD98C, 0xEA);
+        int main = withAlpha(theme.primary(), 0xEE);
+        int accent = withAlpha(theme.secondary(), 0xE0);
+        int style = config.style("hanfu_ornament");
+
+        if (style == 0) { // Jade Tassel
+            Vec3d pinBase = head.add(right.multiply(0.10 * scale)).add(forward.multiply(0.06 * scale)).add(0, 0.17 * scale, 0);
+            Vec3d pinTip = pinBase.add(right.multiply(0.48 * scale)).add(0, 0.10 * scale, 0);
+            ribbon(out, camera, pinBase, pinTip, forward, 0.026 * scale, gold);
+            drawDiamond(out, camera, pinTip, 0.095 * scale, main, tick * 0.018);
+            drawRing(out, camera, pinBase, 0.060 * scale, accent, 0, right, new Vec3d(0, 1, 0));
+            for (int strand = 0; strand < 3; strand++) {
+                Vec3d top = pinTip.add(right.multiply((strand - 1) * 0.045 * scale));
+                Vec3d end = top.add(right.multiply((strand - 1) * 0.03 * scale)).add(0, -(0.24 + strand * 0.045) * scale, 0);
+                ribbon(out, camera, top, end, right, 0.012 * scale, accent);
+                drawDiamond(out, camera, end, 0.032 * scale, gold, 0);
+            }
+        } else if (style == 1) { // Sakura Pin
+            Vec3d flower = head.add(right.multiply(0.28 * scale)).add(forward.multiply(0.05 * scale)).add(0, 0.23 * scale, 0);
+            for (int petal = 0; petal < 5; petal++) {
+                double a = Math.PI * 2.0 * petal / 5.0;
+                Vec3d at = flower.add(right.multiply(Math.cos(a) * 0.105 * scale)).add(0, Math.sin(a) * 0.105 * scale, 0);
+                drawDiamond(out, camera, at, 0.074 * scale, (petal & 1) == 0 ? main : accent, a);
+            }
+            drawDiamond(out, camera, flower, 0.042 * scale, gold, tick * 0.025);
+            Vec3d drop = flower.add(0, -0.30 * scale, 0);
+            ribbon(out, camera, flower, drop, right, 0.014 * scale, gold);
+            drawDiamond(out, camera, drop, 0.045 * scale, accent, 0);
+        } else { // Moon Halo
+            Vec3d crown = head.add(0, 0.24 * scale, 0);
+            drawRing(out, camera, crown, 0.29 * scale, gold, tick * 0.004, right, new Vec3d(0, 1, 0));
+            drawDiamond(out, camera, crown.add(0, 0.10 * scale, 0), 0.11 * scale, main, tick * 0.012);
+            for (int side : new int[]{-1, 1}) {
+                Vec3d star = crown.add(right.multiply(side * 0.27 * scale));
+                drawStar(out, camera, star, 0.065 * scale, accent, side * 0.2 + tick * 0.012);
+                ribbon(out, camera, star, star.add(0, -0.21 * scale, 0), right, 0.012 * scale, gold);
+            }
+        }
+        GEOMETRY_ALPHA.set(previousAlpha);
+    }
